# 문헌 DB API 예절: 요청자 연락처. 대량 수집 시 채워 두는 것이 좋습니다.
CONTACT_EMAIL=

# NCBI API 키(선택). 있으면 PubMed 경로가 초당 3회 → 10회로 올라갑니다.
# 발급: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# 색인 DB 경로 (기본: data/evidence.db)
EVIDENCE_DB=

# 초당 요청 수 (기본 3)
RATE_LIMIT_PER_SEC=3

# 색인에 없는 검색어를 문헌 DB 에 실시간 조회할지 (0 이면 끔)
LIVE_LOOKUP=1
